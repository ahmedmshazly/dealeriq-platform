# DealerIQ - local environment variables. Copy to .env and adjust if needed.
# .env is gitignored; never commit real secrets (gitleaks scans every commit - see
# .pre-commit-config.yaml and .github/workflows/ci.yml).

# ---------- apps/api ----------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Postgres connection string used by the API and Alembic.
# Host/port/user/password/db below must match infra/docker-compose.yml's postgres service.
DATABASE_URL=postgresql+psycopg://dealeriq:dealeriq@localhost:5432/dealeriq

# CORS: comma-separated list of allowed origins for the web app.
CORS_ORIGINS=http://localhost:3000

# JWT signing (FR-001, NFR-002). CHANGE JWT_SECRET_KEY for anything beyond local dev -
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_KEY_ID=dev-1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=dealeriq_refresh
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=15

# Bootstrap Admin account, seeded by the first Alembic migration. Self-registration is
# disabled (FR-004), so this is how the very first login exists on a fresh seed. The seeded
# account has must_change_password=true - change this password after first login regardless.
BOOTSTRAP_ADMIN_EMAIL=admin@dealeriq.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Orders (FR-041): discount above this fraction of list price requires Manager+ approval.
ORDER_APPROVAL_DISCOUNT_THRESHOLD=0.05

# ---------- infra/docker-compose.yml (postgres service) ----------
POSTGRES_USER=dealeriq
POSTGRES_PASSWORD=dealeriq
POSTGRES_DB=dealeriq
POSTGRES_PORT=5432

# Production-only (infra/docker-compose.prod.yml + ADR-026). Local `make dev`
# uses a named volume and ignores these. See docs/runbooks/durability.md.
# DEALERIQ_DATA_ROOT=/var/lib/dealeriq
# BACKUP_S3_URI=s3://dealeriq-prod-backups/prod

# ---------- infra/docker-compose.yml (mailhog service) ----------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
