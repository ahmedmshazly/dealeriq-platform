# DealerIQ — local environment variables. Copy to .env and adjust if needed.
# .env is gitignored; never commit real secrets (gitleaks scans every commit — see
# .pre-commit-config.yaml and .github/workflows/ci.yml).

# ---------- apps/api ----------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Postgres connection string used by the API and Alembic.
# Host/port/user/password/db below must match infra/docker-compose.yml's postgres service.
DATABASE_URL=postgresql+psycopg://dealeriq:dealeriq@localhost:5432/dealeriq

# CORS: comma-separated list of allowed origins for the web app.
CORS_ORIGINS=http://localhost:3000

# ---------- infra/docker-compose.yml (postgres service) ----------
POSTGRES_USER=dealeriq
POSTGRES_PASSWORD=dealeriq
POSTGRES_DB=dealeriq
POSTGRES_PORT=5432

# ---------- infra/docker-compose.yml (mailhog service) ----------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
