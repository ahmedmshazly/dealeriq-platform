    given-names: Ahmed
version: 1.0.0
date-released: 2026-07-12
license: MIT
repository-code: "https://github.com/ahmedmshazly/dealeriq"
keywords:
  - demand forecasting
  - intermittent demand
  - inventory optimization
  - anomaly detection
  - automotive retail
