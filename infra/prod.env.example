# Copy to the EC2 host as /etc/dealeriq/prod.env (never commit real values).
# Used by: docker compose -f infra/docker-compose.prod.yml --env-file /etc/dealeriq/prod.env up -d

APP_ENV=production
LOG_LEVEL=INFO
API_HOST_PORT=8000

POSTGRES_USER=dealeriq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dealeriq

# Host path for the durable Postgres bind-mount (ADR-026). Must match the EBS
# mount in docs/runbooks/durability.md. Local compose ignores this.
DEALERIQ_DATA_ROOT=/var/lib/dealeriq

# Nightly S3 backups use /etc/dealeriq/backup.env (see deploy/systemd/backup.env.example),
# not this file. Prefer an EC2 instance IAM role - do not put AWS access keys here.
# BACKUP_S3_URI=s3://dealeriq-prod-backups/prod

# Comma-separated. Must include the Vercel production URL.
CORS_ORIGINS=https://YOUR_PROJECT.vercel.app

JWT_SECRET_KEY=CHANGE_ME_python_-c_import_secrets_print_secrets.token_urlsafe_48
JWT_KEY_ID=prod-1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=dealeriq_refresh

BOOTSTRAP_ADMIN_EMAIL=admin@dealeriq.dev
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

ORDER_APPROVAL_DISCOUNT_THRESHOLD=0.05
ENABLE_SCHEDULER=true

# Digests are no-op until a real SMTP provider is wired.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_ADDRESS=alerts@dealeriq.dev
DEFAULT_MONTHLY_SALES_TARGET=150000.0
