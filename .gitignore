# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
dist/
build/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/

# Playwright (QA-004)
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# Env / secrets
.env
.env.*
!.env.example

# Data / analytics artifacts (ground truth under infra/seed/ground_truth/ IS committed; so is
# the benchmark harness's own results parquet, DS-OPS-004's "reproducible benchmark artifact")
*.parquet
!infra/seed/ground_truth/**/*.parquet
!docs/paper/results/*.parquet

# LaTeX build artifacts (docs/paper/) -- paper.tex, references.bib, and the compiled paper.pdf
# are committed; the intermediate build files are not.
docs/paper/*.aux
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.log
docs/paper/*.out
docs/paper/*.toc

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/


# Docker volumes (bind-mounted local data, not committed)
infra/pgdata/

# Locally-fetched pinned tool binaries (gitleaks etc.) — fetched by `make bootstrap`
.tools/
