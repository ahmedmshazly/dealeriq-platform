# Host-only env for the backup timer (not loaded by Docker Compose for the API).
# Copy to /etc/dealeriq/backup.env on the production EC2 and chmod 0640.
#
# Auth: prefer an EC2 instance IAM role. Do NOT put long-lived AWS keys here
# unless you have no instance profile (then restrict the IAM user tightly).

BACKUP_S3_URI=s3://dealeriq-prod-backups/prod

# Must match the prod compose bind-mount root (infra/docker-compose.prod.yml).
DEALERIQ_DATA_ROOT=/var/lib/dealeriq

# Production host always uses the prod compose file.
COMPOSE_FILE=infra/docker-compose.prod.yml
COMPOSE_ENV_FILE=/etc/dealeriq/prod.env

# Match prod.env / compose if you overrode the defaults.
# POSTGRES_USER=dealeriq
# POSTGRES_DB=dealeriq
